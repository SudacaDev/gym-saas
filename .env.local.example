# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this .example file is the versioned template.

# --- Database (Supabase Postgres) ---------------------------------------
# Two connections, two different Postgres ROLES — not interchangeable:
#
# DATABASE_TRUSTED_URL: the elevated role (Supabase's default `postgres`
# user). In Supabase this role has `rolbypassrls = true` — RLS never
# applies to it, regardless of FORCE ROW LEVEL SECURITY. Used ONLY for
# migrations, applying db/policies/*.sql, scripts/setup-app-role.ts, and
# the app's own bootstrap/onboarding flow (creating the very first tenant,
# which has no tenant context to scope by yet). Get it from: Supabase
# dashboard -> Connect button (or Project Settings -> Database) ->
# "Session" / direct connection (port 5432).
DATABASE_TRUSTED_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# DATABASE_URL: the restricted `app_user` role that db/rls-context.ts's
# withTenantContext() actually connects as — an ordinary login role RLS
# fully applies to. Do NOT point this at the `postgres` role, or every
# tenant-isolation policy silently becomes a no-op.
#
# Don't hand-fill this one: set DATABASE_TRUSTED_URL above first, then run
# `npm run db:setup-role` — it creates app_user (first run only) and
# writes this value into your real .env.local automatically.
DATABASE_URL="postgresql://app_user:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# --- Supabase Auth --------------------------------------------------------
# Supabase dashboard: Project Settings -> API.
# Project URL:
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# "anon" / "public" key — safe to expose to the browser, subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# "service_role" key — NEVER expose to the client. Bypasses RLS and can
# call the Auth Admin API. Only used server-side, in lib/supabase/admin.ts
# (imported by app/onboarding's bootstrap flow).
SUPABASE_SERVICE_ROLE_KEY="ey..."

# --- Stripe (payments) --------------------------------------------------
# Not used yet — wired up in a later phase (payments/checkout).
# NOTE (2026-08-25, idea to revisit, not decided): Stripe has limited
# support for charging Argentine merchants in ARS. Mercado Pago is the de
# facto standard here instead — surfaced while looking at a competitor
# (bigg.fit) whose marketing site loads a secure.mlstatic.com asset,
# suggesting they likely charge through Mercado Pago. Worth evaluating
# Mercado Pago's checkout/webhook API against this section before actually
# wiring up either gateway — no gateway integration exists yet either way.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (transactional email) ---------------------------------------
# https://resend.com/api-keys. Used by lib/email/resend-client.ts to send
# the payment receipt email (app/api/v1/payments' POST handler) — sending
# is best-effort and never blocks/fails the payment API response.
RESEND_API_KEY=

# Sender address for that email, e.g. "Mi Gimnasio <recibos@migimnasio.com>".
# In Resend's TEST MODE (no verified domain yet), you can use
# "onboarding@resend.dev" as the sender — but it will only successfully
# deliver to the email address your Resend account was created with, any
# other recipient silently won't receive it. Verify a domain in the Resend
# dashboard to send to arbitrary member emails.
RESEND_FROM_EMAIL=

# --- Cron auth (membership reminders) ------------------------------------
# Shared secret for app/api/cron/membership-reminders — any random string,
# e.g. `openssl rand -hex 32`. When deployed on Vercel with this env var
# set, Vercel automatically sends it as the Authorization header when
# invoking the cron job defined in vercel.json (schedule: "0 12 * * *" —
# 12:00 UTC = 09:00 Argentina). Without this set, the route refuses to run.
CRON_SECRET=
